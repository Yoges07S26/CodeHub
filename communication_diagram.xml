<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  =============================================================================
  CodeHub Platform - UML Communication Diagram
  Standard: OMG UML 2.5 / XMI 2.1 Interchange & Structured Sequence Interaction
  Generated for: D:/CodeHub Workspace
  =============================================================================
-->
<uml:Model xmlns:uml="http://www.omg.org/spec/UML/20131001"
           xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
           xmi:version="2.1"
           xmi:id="CodeHub_Communication_Model"
           name="CodeHub_Communication_Architecture">

  <packagedElement xmi:type="uml:Collaboration" xmi:id="Collab_CodeHub_Core" name="CodeHubSystemCommunication">

    <!-- Lifelines / Participating Objects -->
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_User" name="DeveloperClient : ReactSPA"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_Router" name="APIRouter : PHP_Router"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_AuthMiddleware" name="AuthGuard : JWT_Middleware"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_AuthController" name="AuthService : AuthController"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_SettingsController" name="SettingsService : SettingsController"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_DashboardController" name="DashboardService : DashboardController"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_RepoController" name="RepoService : RepositoryController"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_FileController" name="FileService : FileController"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_GeminiService" name="AICopilot : GeminiController"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_FeedController" name="FeedEngine : FeedController"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_AdminController" name="AdminCockpit : AdminController"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_Database" name="RDBMS : MySQL_SQLite_DB"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_GDrive" name="CloudStore : GoogleDriveService"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="LL_AuditLogger" name="AuditEngine : ActivityLogger"/>

    <!-- Communication Interaction Structure -->
    <ownedBehavior xmi:type="uml:Interaction" xmi:id="Interaction_System_Communication" name="CodeHub_Message_Exchanges">

      <!-- 1. Authentication & Security Flow -->
      <message xmi:id="M01" name="1: submitLoginCredentials(email, password)" receiveEvent="LL_AuthController" sendEvent="LL_User"/>
      <message xmi:id="M02" name="1.1: verifyPasswordHash(password)" receiveEvent="LL_Database" sendEvent="LL_AuthController"/>
      <message xmi:id="M03" name="1.2: issueSignedJWT(userPayload)" receiveEvent="LL_User" sendEvent="LL_AuthController"/>
      <message xmi:id="M04" name="1.3: logAuthenticationActivity(USER_LOGIN)" receiveEvent="LL_AuditLogger" sendEvent="LL_AuthController"/>

      <!-- 2. Settings & Profile Multi-Tab Flow -->
      <message xmi:id="M05" name="2: fetchSettingsAndQuota()" receiveEvent="LL_SettingsController" sendEvent="LL_User"/>
      <message xmi:id="M06" name="2.1: validateBearerToken(JWT)" receiveEvent="LL_AuthMiddleware" sendEvent="LL_SettingsController"/>
      <message xmi:id="M07" name="2.2: queryUserProfileAndTokens(userId)" receiveEvent="LL_Database" sendEvent="LL_SettingsController"/>
      <message xmi:id="M08" name="2.3: returnSettingsPayload(profile, 2FA, tokens, quota)" receiveEvent="LL_User" sendEvent="LL_SettingsController"/>
      <message xmi:id="M09" name="3: updateProfileAnd2FA(prefs)" receiveEvent="LL_SettingsController" sendEvent="LL_User"/>
      <message xmi:id="M10" name="3.1: executeUserUpdateSQL(prefs)" receiveEvent="LL_Database" sendEvent="LL_SettingsController"/>
      <message xmi:id="M11" name="3.2: createPersonalAccessToken(tokenName)" receiveEvent="LL_SettingsController" sendEvent="LL_User"/>
      <message xmi:id="M12" name="3.3: storeHashedToken(tokenHash)" receiveEvent="LL_Database" sendEvent="LL_SettingsController"/>

      <!-- 3. Dashboard Real-time Workspace Flow -->
      <message xmi:id="M13" name="4: requestDashboardMetrics()" receiveEvent="LL_DashboardController" sendEvent="LL_User"/>
      <message xmi:id="M14" name="4.1: queryAggregatedStats(repos, commits, issues, PRs, feed, storage)" receiveEvent="LL_Database" sendEvent="LL_DashboardController"/>
      <message xmi:id="M15" name="4.2: fetchRecentActivityLogs(userId, limit=10)" receiveEvent="LL_Database" sendEvent="LL_DashboardController"/>
      <message xmi:id="M16" name="4.3: returnDashboardData(metrics, cloudSyncHealth, recentRepos)" receiveEvent="LL_User" sendEvent="LL_DashboardController"/>

      <!-- 4. Repository & Google Drive Cloud File Management -->
      <message xmi:id="M17" name="5: createRepository(repoName, visibility)" receiveEvent="LL_RepoController" sendEvent="LL_User"/>
      <message xmi:id="M18" name="5.1: allocateDriveFolder(repoName)" receiveEvent="LL_GDrive" sendEvent="LL_RepoController"/>
      <message xmi:id="M19" name="5.2: insertRepoRecord(repoData, folderId)" receiveEvent="LL_Database" sendEvent="LL_RepoController"/>
      <message xmi:id="M20" name="6: commitAndPushFile(branchId, filePath, content, commitMsg)" receiveEvent="LL_FileController" sendEvent="LL_User"/>
      <message xmi:id="M21" name="6.1: uploadFileSnapshot(fileData)" receiveEvent="LL_GDrive" sendEvent="LL_FileController"/>
      <message xmi:id="M22" name="6.2: recordFileVersionSnapshot(versionNumber, sha40)" receiveEvent="LL_Database" sendEvent="LL_FileController"/>
      <message xmi:id="M23" name="6.3: rollbackFileVersion(fileId, targetVersion)" receiveEvent="LL_FileController" sendEvent="LL_User"/>

      <!-- 5. AI Copilot Integration Flow -->
      <message xmi:id="M24" name="7: sendCopilotPrompt(codeContext, question)" receiveEvent="LL_GeminiService" sendEvent="LL_User"/>
      <message xmi:id="M25" name="7.1: evaluateCodeAnalysis(GeminiRESTAPI)" receiveEvent="LL_GeminiService" sendEvent="LL_GeminiService"/>
      <message xmi:id="M26" name="7.2: returnAIReviewResponse(markdownFormatted)" receiveEvent="LL_User" sendEvent="LL_GeminiService"/>

      <!-- 6. Developer Community Feed Flow -->
      <message xmi:id="M27" name="8: publishFeedPost(content, codeSnippet, imageBase64)" receiveEvent="LL_FeedController" sendEvent="LL_User"/>
      <message xmi:id="M28" name="8.1: insertFeedPostRecord(postData)" receiveEvent="LL_Database" sendEvent="LL_FeedController"/>
      <message xmi:id="M29" name="8.2: togglePostLike(postId, userId)" receiveEvent="LL_FeedController" sendEvent="LL_User"/>
      <message xmi:id="M30" name="8.3: updateLikeCountTransaction(postId)" receiveEvent="LL_Database" sendEvent="LL_FeedController"/>

      <!-- 7. Administrator Cockpit & Audit Logging Flow -->
      <message xmi:id="M31" name="9: fetchAdminCockpitOverview()" receiveEvent="LL_AdminController" sendEvent="LL_User"/>
      <message xmi:id="M32" name="9.1: requireAdminRolePrivilege()" receiveEvent="LL_AuthMiddleware" sendEvent="LL_AdminController"/>
      <message xmi:id="M33" name="9.2: loadGlobalMetricsAndAuditLogs()" receiveEvent="LL_Database" sendEvent="LL_AdminController"/>
      <message xmi:id="M34" name="9.3: processDeletionRequest(requestId, approve/reject)" receiveEvent="LL_AdminController" sendEvent="LL_User"/>
      <message xmi:id="M35" name="9.4: cascadePurgeUserDataAndDriveFiles(targetUserId)" receiveEvent="LL_GDrive" sendEvent="LL_AdminController"/>
      <message xmi:id="M36" name="9.5: writeAuditEntry(ADMIN_ACTION, description, ip)" receiveEvent="LL_AuditLogger" sendEvent="LL_AdminController"/>

    </ownedBehavior>
  </packagedElement>
</uml:Model>
