<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  =============================================================================
  CodeHub Platform - UML Use Case Diagram
  Standard: OMG UML 2.5 / XMI 2.1 Use Case Specifications
  Generated for: D:/CodeHub Workspace
  =============================================================================
-->
<uml:Model xmlns:uml="http://www.omg.org/spec/UML/20131001"
           xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
           xmi:version="2.1"
           xmi:id="CodeHub_UseCase_Model"
           name="CodeHub_UseCase_Architecture">

  <!-- ================= ACTORS ================= -->
  <packagedElement xmi:type="uml:Actor" xmi:id="Actor_Developer" name="Developer / Registered User">
    <ownedComment xmi:id="Comm_Actor_Dev" body="Authenticated software engineer interacting with workspaces, version control, AI assistance, and feed."/>
  </packagedElement>

  <packagedElement xmi:type="uml:Actor" xmi:id="Actor_Admin" name="System Administrator">
    <general xmi:idref="Actor_Developer"/>
    <ownedComment xmi:id="Comm_Actor_Admin" body="Privileged administrator managing platform operations, audits, user status, and account deletions."/>
  </packagedElement>

  <packagedElement xmi:type="uml:Actor" xmi:id="Actor_GeminiAI" name="Google Gemini AI Engine">
    <ownedComment xmi:id="Comm_Actor_AI" body="External Large Language Model providing real-time code reviews, PR summaries, and architectural recommendations."/>
  </packagedElement>

  <packagedElement xmi:type="uml:Actor" xmi:id="Actor_GoogleDrive" name="Google Drive Storage Service">
    <ownedComment xmi:id="Comm_Actor_GDrive" body="Cloud file storage backend hosting repository file trees, snapshot payloads, and version rollback files."/>
  </packagedElement>

  <!-- ================= SYSTEM BOUNDARY ================= -->
  <packagedElement xmi:type="uml:Component" xmi:id="System_CodeHub" name="CodeHub Developer Platform">

    <!-- Subsystem 1: Identity & Access Management -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC01_Auth" name="Authenticate &amp; Register Account">
      <extensionPoint xmi:id="EP_BubbleAnim" name="Animated Bubble Canvas Interaction"/>
      <extensionPoint xmi:id="EP_AvatarUpload" name="Custom Profile Image Selection"/>
    </packagedElement>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC02_VerifyEmail" name="Verify Email Address"/>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC03_ManageSettings" name="Configure Profile, Security &amp; 2FA Preferences">
      <include xmi:id="Inc_UpdateBio" addition="UC03a_Bio"/>
      <include xmi:id="Inc_PasswordChange" addition="UC03b_Password"/>
      <include xmi:id="Inc_TwoFactor" addition="UC03c_2FA"/>
      <include xmi:id="Inc_Notifications" addition="UC03d_Notifications"/>
    </packagedElement>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC03a_Bio" name="Update Bio, Org, Location &amp; Website"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC03b_Password" name="Change Account Security Password"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC03c_2FA" name="Toggle Two-Factor Authentication Status"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC03d_Notifications" name="Set Email, PR &amp; Security Alerts"/>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC04_ManageTokens" name="Generate &amp; Revoke Personal Access Tokens (PAT)"/>

    <!-- Subsystem 2: Workspace & Developer Dashboard -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC05_ViewDashboard" name="View Workspace Dashboard &amp; Cloud Drive Health">
      <include xmi:id="Inc_DashStats" addition="UC05a_Stats"/>
      <include xmi:id="Inc_DashActivity" addition="UC05b_Activity"/>
    </packagedElement>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC05a_Stats" name="Inspect 6-Metric Statistical Breakdown"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC05b_Activity" name="Audit Workspace Activity Timeline"/>

    <!-- Subsystem 3: Repositories & Cloud Version Control -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC06_ManageRepos" name="Create &amp; Explore Code Repositories">
      <include xmi:id="Inc_AllocDrive" addition="UC06a_DriveFolder"/>
    </packagedElement>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC06a_DriveFolder" name="Allocate Cloud Google Drive Workspace Folder"/>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC07_BranchAndFiles" name="Branching, Code Editing &amp; File Staging"/>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC08_CommitRollback" name="Commit Snapshot &amp; Rollback File Versions">
      <include xmi:id="Inc_VersionSnap" addition="UC08a_SyncCloud"/>
    </packagedElement>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC08a_SyncCloud" name="Synchronize Snapshot Payloads to Google Drive"/>

    <!-- Subsystem 4: Collaboration, Issues & AI Copilot -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC09_IssuesPRs" name="Manage Issues &amp; Propose Pull Requests"/>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC10_AICopilot" name="Consult Gemini AI Copilot for Code Analysis &amp; Security Reviews"/>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC11_CommunityFeed" name="Publish Code Snippets &amp; Like Community Posts"/>

    <!-- Subsystem 5: Governance & Administration -->
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC12_RequestDeletion" name="Submit Account Deletion Request with Rationale"/>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC13_AdminCockpit" name="Operate Administrator Cockpit &amp; User Moderation">
      <include xmi:id="Inc_UserRoles" addition="UC13a_Roles"/>
      <include xmi:id="Inc_AuditLogs" addition="UC13b_Logs"/>
      <include xmi:id="Inc_PurgeApprove" addition="UC13c_Purge"/>
    </packagedElement>

    <packagedElement xmi:type="uml:UseCase" xmi:id="UC13a_Roles" name="Modify User Roles &amp; Suspend / Block Accounts"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC13b_Logs" name="Inspect System-wide Immutable Audit Logs"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="UC13c_Purge" name="Review &amp; Approve Permanent Data Purges"/>

  </packagedElement>

  <!-- ================= ASSOCIATIONS ================= -->
  <!-- Developer Associations -->
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Auth" memberEnd="Actor_Developer UC01_Auth"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Verify" memberEnd="Actor_Developer UC02_VerifyEmail"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Settings" memberEnd="Actor_Developer UC03_ManageSettings"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Tokens" memberEnd="Actor_Developer UC04_ManageTokens"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Dashboard" memberEnd="Actor_Developer UC05_ViewDashboard"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Repos" memberEnd="Actor_Developer UC06_ManageRepos"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Files" memberEnd="Actor_Developer UC07_BranchAndFiles"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Versions" memberEnd="Actor_Developer UC08_CommitRollback"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Issues" memberEnd="Actor_Developer UC09_IssuesPRs"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_AI" memberEnd="Actor_Developer UC10_AICopilot"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_Feed" memberEnd="Actor_Developer UC11_CommunityFeed"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Dev_DeleteReq" memberEnd="Actor_Developer UC12_RequestDeletion"/>

  <!-- Admin Associations -->
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Admin_Cockpit" memberEnd="Actor_Admin UC13_AdminCockpit"/>

  <!-- External System Associations -->
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_AI_Copilot" memberEnd="Actor_GeminiAI UC10_AICopilot"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Drive_Alloc" memberEnd="Actor_GoogleDrive UC06a_DriveFolder"/>
  <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Drive_Sync" memberEnd="Actor_GoogleDrive UC08a_SyncCloud"/>

</uml:Model>
