<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  =============================================================================
  CodeHub Platform - UML Activity Diagram
  Standard: OMG UML 2.5 / XMI 2.1 Complete Behavioral Workflow Specifications
  Generated for: D:/CodeHub Workspace
  =============================================================================
-->
<uml:Model xmlns:uml="http://www.omg.org/spec/UML/20131001"
           xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
           xmi:version="2.1"
           xmi:id="CodeHub_Activity_Model"
           name="CodeHub_Activity_Workflows">

  <!-- Activity 1: Authentication & Workspace Session Initialization -->
  <packagedElement xmi:type="uml:Activity" xmi:id="Act_Authentication" name="UserAuthenticationAndSessionInit">
    <node xmi:type="uml:InitialNode" xmi:id="Init_Auth"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_LoadAuthPage" name="Render Animated Bubble Canvas &amp; Auth Form"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_InputCredentials" name="Developer Enters Email &amp; Password"/>
    <node xmi:type="uml:DecisionNode" xmi:id="Dec_AuthType" name="Sign In or Register?"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_ExecuteRegister" name="Hash Password with Bcrypt &amp; Insert User Profile"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_ExecuteLogin" name="Verify Credentials Against Database"/>
    <node xmi:type="uml:DecisionNode" xmi:id="Dec_AuthValid" name="Credentials Valid?"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_ShowAuthError" name="Display Toast Error Notification"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_IssueJWT" name="Generate HMAC-SHA256 JWT Bearer Token"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_StoreLocalStorage" name="Persist Session in Browser LocalStorage"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_RedirectDashboard" name="Transition to Role-Aware Dashboard Workspace"/>
    <node xmi:type="uml:ActivityFinalNode" xmi:id="Final_Auth"/>

    <!-- Control Flows -->
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A1" source="Init_Auth" target="Act_LoadAuthPage"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A2" source="Act_LoadAuthPage" target="Act_InputCredentials"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A3" source="Act_InputCredentials" target="Dec_AuthType"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A4" source="Dec_AuthType" target="Act_ExecuteRegister" guard="New Account"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A5" source="Dec_AuthType" target="Act_ExecuteLogin" guard="Existing Account"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A6" source="Act_ExecuteRegister" target="Act_ExecuteLogin"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A7" source="Act_ExecuteLogin" target="Dec_AuthValid"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A8" source="Dec_AuthValid" target="Act_ShowAuthError" guard="Invalid"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A9" source="Act_ShowAuthError" target="Act_InputCredentials"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A10" source="Dec_AuthValid" target="Act_IssueJWT" guard="Valid"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A11" source="Act_IssueJWT" target="Act_StoreLocalStorage"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A12" source="Act_StoreLocalStorage" target="Act_RedirectDashboard"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_A13" source="Act_RedirectDashboard" target="Final_Auth"/>
  </packagedElement>

  <!-- Activity 2: Repository File Editing, Snapshot & Cloud Drive Sync -->
  <packagedElement xmi:type="uml:Activity" xmi:id="Act_FileVersioning" name="RepositoryFileEditingAndCloudSync">
    <node xmi:type="uml:InitialNode" xmi:id="Init_File"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_SelectRepoBranch" name="Select Repository &amp; Active Branch"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_LoadFileTree" name="Fetch File Tree and Latest Content from Database"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_EditCode" name="Developer Edits Code in Web IDE"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_SubmitCommit" name="Developer Submits Commit with Message"/>
    <node xmi:type="uml:ForkNode" xmi:id="Fork_Commit"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_UploadGDrive" name="Upload Raw Content Snapshot to Google Drive Folder"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_RecordDBCommit" name="Insert Record into repository_commits (SHA-40)"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_IncrementVersion" name="Add file_version_history Entry (v+1)"/>
    <node xmi:type="uml:JoinNode" xmi:id="Join_Commit"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_LogFileActivity" name="Write to Activity Audit Ledger"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_NotifySuccess" name="Display Commit &amp; Push Confirmation Toast"/>
    <node xmi:type="uml:ActivityFinalNode" xmi:id="Final_File"/>

    <!-- Control Flows -->
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F1" source="Init_File" target="Act_SelectRepoBranch"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F2" source="Act_SelectRepoBranch" target="Act_LoadFileTree"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F3" source="Act_LoadFileTree" target="Act_EditCode"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F4" source="Act_EditCode" target="Act_SubmitCommit"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F5" source="Act_SubmitCommit" target="Fork_Commit"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F6" source="Fork_Commit" target="Act_UploadGDrive"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F7" source="Fork_Commit" target="Act_RecordDBCommit"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F8" source="Fork_Commit" target="Act_IncrementVersion"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F9" source="Act_UploadGDrive" target="Join_Commit"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F10" source="Act_RecordDBCommit" target="Join_Commit"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F11" source="Act_IncrementVersion" target="Join_Commit"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F12" source="Join_Commit" target="Act_LogFileActivity"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F13" source="Act_LogFileActivity" target="Act_NotifySuccess"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_F14" source="Act_NotifySuccess" target="Final_File"/>
  </packagedElement>

  <!-- Activity 3: Settings, Security & Personal Access Token Lifecycle -->
  <packagedElement xmi:type="uml:Activity" xmi:id="Act_SettingsWorkflow" name="SettingsAndTokenManagement">
    <node xmi:type="uml:InitialNode" xmi:id="Init_Settings"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_OpenSettings" name="Open Settings Dashboard"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_LoadUserData" name="Load Profile, Cloud Quota, 2FA &amp; Tokens via API"/>
    <node xmi:type="uml:DecisionNode" xmi:id="Dec_SettingsAction" name="Target Settings Tab?"/>
    
    <!-- Profile Path -->
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_UpdateProfile" name="Edit Bio, Organization, Location &amp; Website"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_SaveProfileDB" name="Execute UPDATE users SET profile Fields"/>
    
    <!-- Password Path -->
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_VerifyOldPass" name="Verify Current Password Hash"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_SaveNewPass" name="Hash &amp; Save New Password"/>
    
    <!-- PAT Path -->
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_GeneratePAT" name="Generate Cryptographic Access Token (chp_...)"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_DisplayToken" name="Show One-Time Copyable Token Box"/>

    <!-- Common Completion -->
    <node xmi:type="uml:MergeNode" xmi:id="Merge_Settings"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="Act_UpdateLocalStorageUser" name="Refresh LocalStorage &amp; Application State"/>
    <node xmi:type="uml:ActivityFinalNode" xmi:id="Final_Settings"/>

    <!-- Control Flows -->
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S1" source="Init_Settings" target="Act_OpenSettings"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S2" source="Act_OpenSettings" target="Act_LoadUserData"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S3" source="Act_LoadUserData" target="Dec_SettingsAction"/>
    
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S4" source="Dec_SettingsAction" target="Act_UpdateProfile" guard="Profile Tab"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S5" source="Act_UpdateProfile" target="Act_SaveProfileDB"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S6" source="Act_SaveProfileDB" target="Merge_Settings"/>

    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S7" source="Dec_SettingsAction" target="Act_VerifyOldPass" guard="Security Tab"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S8" source="Act_VerifyOldPass" target="Act_SaveNewPass"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S9" source="Act_SaveNewPass" target="Merge_Settings"/>

    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S10" source="Dec_SettingsAction" target="Act_GeneratePAT" guard="Tokens Tab"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S11" source="Act_GeneratePAT" target="Act_DisplayToken"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S12" source="Act_DisplayToken" target="Merge_Settings"/>

    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S13" source="Merge_Settings" target="Act_UpdateLocalStorageUser"/>
    <edge xmi:type="uml:ControlFlow" xmi:id="CF_S14" source="Act_UpdateLocalStorageUser" target="Final_Settings"/>
  </packagedElement>

</uml:Model>
